# Copy to .env for local runs. On Render these are set under Environment.
# .env is git-ignored; never commit real values.

# --- required -------------------------------------------------------------------
# Supabase → Connect → Session pooler (not the direct db.<ref> host: it is IPv6 only)
# postgresql://postgres.mbazpiignlrayzbwbxth:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
FRONTEND_URL=http://localhost:5500

# --- payments (each switches on when set) ---------------------------------------
KORA_SECRET_KEY=
# free from console.groq.com; turns on the Live chat assistant
GROQ_API_KEY=
# MPESA_PROVIDER=kora     set to payhero to send M-Pesa through PayHero instead
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_TOKEN=any-long-random-string
PAYSTACK_SECRET_KEY=

# --- local only -------------------------------------------------------------------
ENV=development
# where PayHero can reach this machine (a tunnel), since Render's address does not apply locally
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://127.0.0.1:5500

# --- optional overrides (defaults in app/config.py) -------------------------------
# USD_KES_RATE=129.5
# MIN_DEPOSIT_USD=5
# MIN_WITHDRAW_USD=5
# WITHDRAW_FEE_USD=1
# CARD_FEE_PCT=1.5
# PAYSTACK_CURRENCY=KES
# SUPABASE_JWT_SECRET=      only for projects still on the legacy JWT secret

# Admin site: the admin API exists only with ADMIN_TOKEN set (32+ characters).
# ADMIN_URL is the admin site, always allowed by CORS.
# ADMIN_TOKEN=
# ADMIN_URL=https://admin.obisflow.com
